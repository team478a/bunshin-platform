# Runtime environment: development, staging, or production.
APP_ENV=

# Public base URL for this deployment. This value is server-only in Phase 1.
APP_URL=
LINE_OFFICIAL_ACCOUNT_URL=

# Pooled PostgreSQL URL used by the application at runtime.
DATABASE_URL=

# Direct PostgreSQL URL used only by Prisma migrations and administrative commands.
DIRECT_URL=

# Minimum 32-character application session signing secret. Reserved for the auth phase.
SESSION_SECRET=
ENCRYPTION_KEY=
LINE_CONFIG_KEY_VERSION=1
LINE_DEEP_LINK_KEY_VERSION=1
VIDEO_RENDER_WEBHOOK_KEY_VERSION=1

# Optional external administrator alert webhook. The host must also be explicitly allowlisted.
LINE_ADMIN_ALERT_WEBHOOK_URL=
LINE_ADMIN_ALERT_WEBHOOK_TOKEN=
LINE_ADMIN_ALERT_WEBHOOK_ALLOWED_HOSTS=

# Supabase Auth project values. The publishable key is safe for browser use; never put service-role keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase Auth administration values. Configure all three together.
# Never expose the service-role key through NEXT_PUBLIC_ variables.
SUPABASE_AUTH_ADMIN_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_ADMIN_ENV=
ACCOUNT_DELETION_EXECUTION_MODE=disabled
ACCOUNT_DELETION_PRODUCTION_APPROVED=false

# Log threshold: debug, info, warn, or error.
LOG_LEVEL=

# Server-only OpenAI key and optional Strategy Generator model override.
OPENAI_API_KEY=
OPENAI_STRATEGY_MODEL=gpt-5.2
