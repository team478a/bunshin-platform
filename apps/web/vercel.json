{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["hnd1"],
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=web",
  "crons": [
    { "path": "/api/internal/jobs/schedule", "schedule": "* * * * *" },
    { "path": "/api/internal/jobs/run", "schedule": "* * * * *" },
    { "path": "/api/internal/line/monitor", "schedule": "0 * * * *" },
    { "path": "/api/internal/account-deletions/run", "schedule": "15 18 * * *" },
    { "path": "/api/internal/points/release-expired", "schedule": "*/5 * * * *" }
  ],
  "functions": {
    "app/api/workspaces/[workspaceId]/bunshins/[bunshinId]/daily-missions/generate/route.ts": {
      "maxDuration": 60
    }
  }
}
