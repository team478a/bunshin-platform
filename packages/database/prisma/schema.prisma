generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AuthProvider {
  LINE
  EMAIL
}

enum WorkspaceType {
  PERSONAL
  ORGANIZATION
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum PlatformRole {
  SUPER_ADMIN
  OPERATOR
  SUPPORT
  READ_ONLY
}

enum PlatformAdminStatus {
  ACTIVE
  REVOKED
}

enum LineConfigurationEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum LineConfigurationStatus {
  DRAFT
  ACTIVE
  DISABLED
  ERROR
}

enum AiProviderKey {
  OPENAI
  EXA
  FIRECRAWL
}

enum AiProviderConfigurationStatus {
  DRAFT
  ACTIVE
  DISABLED
  ERROR
}

enum LineNotificationFrequency {
  DAILY
  WEEKDAYS
}

enum LegalDocumentType {
  TERMS
  PRIVACY
}

enum LegalDocumentStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum AccountDeletionRequestStatus {
  REQUESTED
  PROCESSING
  BLOCKED
  CANCELLED
  COMPLETED
}

enum JobStatus {
  PENDING
  LEASED
  RETRY_SCHEDULED
  SUCCEEDED
  DEAD
  CANCELLED
}

enum LineMessageDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum LineMessageAttemptStatus {
  SUCCESS
  FAILED
}

enum LineMessageKind {
  DAILY_MISSION
  REMINDER
}

enum LineConnectionStatus {
  ACTIVE
  DISCONNECTED
}

enum LineFriendshipStatus {
  UNKNOWN
  FOLLOWING
  UNFOLLOWED
}

enum LineWebhookEventType {
  FOLLOW
  UNFOLLOW
  OTHER
}

enum LineWebhookEventOutcome {
  APPLIED
  DUPLICATE
  IDENTITY_NOT_FOUND
  CONNECTION_NOT_FOUND
  IGNORED
}

enum BunshinType {
  COPY
  EXPERT
  BRAND
  CHARACTER
}

enum BunshinStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ObjectiveStatus {
  ACTIVE
  INACTIVE
}

enum FacePolicy {
  FACE_OK
  FACE_NG_VOICE_OK
  FACE_VOICE_NG
  FULL_ANONYMOUS
}

enum OwnerKnowledgeType {
  PROFILE
  EXPERIENCE
  SKILL
  PRODUCT
  FAQ
  CASE
  ASSET
  OTHER
}

enum KnowledgeSourceType {
  MANUAL
  IMPORT
  SYSTEM
}

enum OwnerKnowledgeStatus {
  ACTIVE
  ARCHIVED
}

enum KnowledgeGrantStatus {
  ACTIVE
  REVOKED
}

enum BunshinMemoryType {
  BELIEF
  EXPERIENCE
  KNOWLEDGE
  STORY
  FAQ
  OPINION
  PREFERENCE
  PERFORMANCE_INSIGHT
}

enum BunshinMemorySourceType {
  USER_INPUT
  MISSION_FEEDBACK
  PERFORMANCE
  IMPORT
  SYSTEM
}

enum CapabilityType {
  SOCIAL
  BLOG
  LINE_MARKETING
  LP
  LEAD_GENERATION
  SALES
  CUSTOMER_SUPPORT
}

enum CapabilityAssignmentStatus {
  ACTIVE
  SUSPENDED
  LOCKED
}

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  X
  THREADS
  YOUTUBE_SHORTS
  OTHER
}

enum SocialPostingFrequency {
  DAILY
  WEEKDAYS
  THREE_PER_WEEK
  WEEKLY
  FLEXIBLE
}

enum SocialProfileStatus {
  ACTIVE
  INACTIVE
}

enum SocialAccountStrategyGoal {
  FOLLOWERS
  LINE_REGISTRATION
  INQUIRY
  SALES
  RECRUIT
  BRAND_AWARENESS
  BLOG_TRAFFIC
  OTHER
}

enum SocialAccountStrategyDestination {
  PROFILE
  LINE
  LP
  BLOG
  EC
  INQUIRY
  RECRUIT_PAGE
  NONE
  OTHER
}

enum SocialAccountStrategyStatus {
  DRAFT
  PROPOSED
  APPROVED
  SUPERSEDED
}

enum WeeklyPlanStatus {
  DRAFT
  CONFIRMED
  EXPIRED
}

enum DailyMissionStatus {
  GENERATED
  VIEWED
  STARTED
  COMPLETED
  SKIPPED
  EXPIRED
}

enum MissionDecisionValue {
  PENDING
  ACCEPTED
  REJECTED
}

enum MissionRejectionReason {
  NOT_MY_STYLE
  WRONG_TOPIC
  TOO_DIFFICULT
  TOO_MUCH_WORK
  SIMILAR_TO_PAST
  TOO_SALESY
  NOT_TODAY
  OTHER
}

enum MissionActivityType {
  VIEWED
  ACCEPTED
  REJECTED
  COPIED_TEXT
  COPIED_SLIDE
  COPIED_VIDEO_PROMPT
  COPIED_SCRIPT
  POSTED
  FEEDBACK_GOOD
  FEEDBACK_NEUTRAL
  FEEDBACK_BAD
}

enum PostSource {
  MANUAL
}

enum MissionFeedbackRating {
  GOOD
  NEUTRAL
  BAD
}

enum AiUsageStatus {
  SUCCESS
  FAILED
}

enum SocialPreferredFormat {
  TEXT
  SLIDE
  LIVE_ACTION
  AI_VIDEO_PROMPT
  IMAGE
}

enum ContentAssistanceLevel {
  IDEA_ONLY
  GUIDED
  READY_TO_USE
}

enum TrendResearchRunStatus {
  COMPLETED
  FAILED
  EXPIRED
}

enum TrendEvidenceSourceType {
  OFFICIAL_API
  PUBLIC_WEB
  NEWS
  OTHER
}

enum TrendEvidenceStatus {
  ACTIVE
  EXPIRED
  REJECTED
}

enum TrendIdeaCandidateStatus {
  PROPOSED
  SELECTED
  REJECTED
  EXPIRED
}

enum TrendSafetyStatus {
  SAFE
  REVIEW_REQUIRED
  REJECTED
}

model User {
  id                            String                          @id @default(uuid()) @db.Uuid
  status                        UserStatus                      @default(ACTIVE)
  displayName                   String                          @map("display_name") @db.VarChar(100)
  email                         String?                         @db.VarChar(320)
  createdAt                     DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(6)
  identities                    AuthIdentity[]
  memberships                   WorkspaceMembership[]
  platformAdmin                 PlatformAdmin?
  bunshins                      Bunshin[]
  ownerKnowledge                OwnerKnowledge[]                @relation("KnowledgeOwner")
  knowledgeGrants               BunshinKnowledgeGrant[]         @relation("GrantActor")
  capabilityAssignments         BunshinCapabilityAssignment[]   @relation("CapabilityAssignmentActor")
  missionActivities             MissionActivity[]               @relation("MissionActivityActor")
  postRecords                   PostRecord[]                    @relation("PostRecordActor")
  missionFeedback               MissionFeedback[]               @relation("MissionFeedbackActor")
  aiUsageEvents                 AiUsageEvent[]                  @relation("AiUsageActor")
  legalDocuments                LegalDocument[]                 @relation("LegalDocumentAuthor")
  legalConsents                 UserLegalConsent[]
  accountDeletionRequests       AccountDeletionRequest[]
  accountDeletionAudits         AccountDeletionOperationAudit[] @relation("AccountDeletionAuditActor")
  lineConfigurationAudits       LineConfigurationAudit[]        @relation("LineConfigurationAuditActor")
  aiProviderConfigurationAudits AiProviderConfigurationAudit[]  @relation("AiProviderConfigurationAuditActor")
  lineNotificationPreferences   LineNotificationPreference[]
  lineConnections               LineConnection[]
  jobs                          Job[]
  lineMessageDeliveries         LineMessageDelivery[]
  missionDeepLinkStates         MissionDeepLinkState[]
  lineDeliveryRetryRequests     LineDeliveryRetryRequest[]      @relation("LineDeliveryRetryActor")

  @@index([status])
  @@map("users")
}

model AuthIdentity {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  provider       AuthProvider
  providerUserId String       @map("provider_user_id") @db.VarChar(255)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

model Workspace {
  id                          String                        @id @default(uuid()) @db.Uuid
  type                        WorkspaceType
  name                        String                        @db.VarChar(120)
  status                      WorkspaceStatus               @default(ACTIVE)
  createdAt                   DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships                 WorkspaceMembership[]
  bunshins                    Bunshin[]
  ownerKnowledge              OwnerKnowledge[]
  knowledgeGrants             BunshinKnowledgeGrant[]
  memories                    BunshinMemory[]
  capabilityAssignments       BunshinCapabilityAssignment[]
  socialProfiles              SocialProfile[]
  socialAccountStrategies     SocialAccountStrategy[]
  contentPillars              ContentPillar[]
  weeklyPlans                 WeeklyPlan[]
  weeklyPlanItems             WeeklyPlanItem[]
  dailyMissions               DailyMission[]
  missionContents             MissionContent[]
  missionDecisions            MissionDecision[]
  missionActivities           MissionActivity[]
  postRecords                 PostRecord[]
  missionFeedback             MissionFeedback[]
  aiUsageEvents               AiUsageEvent[]
  lineNotificationPreferences LineNotificationPreference[]
  lineConnections             LineConnection[]
  lineWebhookEvents           LineWebhookEvent[]
  jobs                        Job[]
  lineMessageDeliveries       LineMessageDelivery[]
  missionDeepLinkStates       MissionDeepLinkState[]
  trendResearchRuns           TrendResearchRun[]
  trendEvidence               TrendEvidence[]
  trendIdeaCandidates         TrendIdeaCandidate[]

  @@index([status])
  @@map("workspaces")
}

model WorkspaceMembership {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  role        WorkspaceRole
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, status])
  @@map("workspace_memberships")
}

model PlatformAdmin {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @unique @map("user_id") @db.Uuid
  role      PlatformRole
  status    PlatformAdminStatus @default(ACTIVE)
  grantedAt DateTime            @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt DateTime?           @map("revoked_at") @db.Timestamptz(6)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, role])
  @@map("platform_admins")
}

model LineChannelConfiguration {
  id                       String                       @id @default(uuid()) @db.Uuid
  environment              LineConfigurationEnvironment
  version                  Int
  status                   LineConfigurationStatus      @default(DRAFT)
  loginChannelId           String                       @map("login_channel_id") @db.VarChar(64)
  encryptedLoginSecret     String                       @map("encrypted_login_secret") @db.Text
  loginSecretMask          String                       @map("login_secret_mask") @db.VarChar(16)
  messagingChannelId       String                       @map("messaging_channel_id") @db.VarChar(64)
  encryptedMessagingSecret String                       @map("encrypted_messaging_secret") @db.Text
  messagingSecretMask      String                       @map("messaging_secret_mask") @db.VarChar(16)
  encryptedAccessToken     String                       @map("encrypted_access_token") @db.Text
  accessTokenMask          String                       @map("access_token_mask") @db.VarChar(16)
  liffId                   String?                      @map("liff_id") @db.VarChar(128)
  defaultNotificationTime  String                       @default("08:00") @map("default_notification_time") @db.VarChar(5)
  defaultTimezone          String                       @default("Asia/Tokyo") @map("default_timezone") @db.VarChar(64)
  quietHoursStart          String                       @default("21:00") @map("quiet_hours_start") @db.VarChar(5)
  quietHoursEnd            String                       @default("07:00") @map("quiet_hours_end") @db.VarChar(5)
  globallyPaused           Boolean                      @default(false) @map("globally_paused")
  quotaWarningPercent      Int                          @default(80) @map("quota_warning_percent")
  quotaLowPriorityStop     Int                          @default(90) @map("quota_low_priority_stop")
  keyVersion               Int                          @default(1) @map("key_version")
  lastVerifiedAt           DateTime?                    @map("last_verified_at") @db.Timestamptz(6)
  lastErrorCategory        String?                      @map("last_error_category") @db.VarChar(80)
  createdAt                DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  audits                   LineConfigurationAudit[]

  @@unique([environment, version])
  @@index([environment, status])
  @@map("line_channel_configurations")
}

model LineConfigurationAudit {
  id              String                       @id @default(uuid()) @db.Uuid
  configurationId String                       @map("configuration_id") @db.Uuid
  environment     LineConfigurationEnvironment
  actorUserId     String                       @map("actor_user_id") @db.Uuid
  action          String                       @db.VarChar(40)
  reason          String                       @db.VarChar(500)
  changedFields   Json                         @map("changed_fields")
  occurredAt      DateTime                     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  configuration   LineChannelConfiguration     @relation(fields: [configurationId], references: [id], onDelete: Restrict)
  actor           User                         @relation("LineConfigurationAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([configurationId, occurredAt])
  @@index([environment, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("line_configuration_audits")
}

model AiProviderConfiguration {
  id                     String                         @id @default(uuid()) @db.Uuid
  environment            LineConfigurationEnvironment
  provider               AiProviderKey
  version                Int
  status                 AiProviderConfigurationStatus  @default(DRAFT)
  encryptedApiKey        String?                        @map("encrypted_api_key") @db.Text
  apiKeyMask             String?                        @map("api_key_mask") @db.VarChar(16)
  model                  String?                        @db.VarChar(120)
  dailyBudgetUsdMicros   Int                            @default(1000000) @map("daily_budget_usd_micros")
  monthlyBudgetUsdMicros Int                            @default(5000000) @map("monthly_budget_usd_micros")
  globallyPaused         Boolean                        @default(true) @map("globally_paused")
  keyVersion             Int                            @default(1) @map("key_version")
  lastVerifiedAt         DateTime?                      @map("last_verified_at") @db.Timestamptz(6)
  lastErrorCategory      String?                        @map("last_error_category") @db.VarChar(80)
  createdAt              DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  audits                 AiProviderConfigurationAudit[]

  @@unique([environment, provider, version])
  @@index([environment, provider, status])
  @@map("ai_provider_configurations")
}

model AiProviderConfigurationAudit {
  id              String                       @id @default(uuid()) @db.Uuid
  configurationId String                       @map("configuration_id") @db.Uuid
  environment     LineConfigurationEnvironment
  provider        AiProviderKey
  actorUserId     String                       @map("actor_user_id") @db.Uuid
  action          String                       @db.VarChar(40)
  reason          String                       @db.VarChar(500)
  changedFields   Json                         @map("changed_fields")
  occurredAt      DateTime                     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  configuration   AiProviderConfiguration      @relation(fields: [configurationId], references: [id], onDelete: Restrict)
  actor           User                         @relation("AiProviderConfigurationAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([configurationId, occurredAt])
  @@index([environment, provider, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("ai_provider_configuration_audits")
}

model LineNotificationPreference {
  id                    String                    @id @default(uuid()) @db.Uuid
  workspaceId           String                    @map("workspace_id") @db.Uuid
  userId                String                    @map("user_id") @db.Uuid
  bunshinId             String                    @map("bunshin_id") @db.Uuid
  enabled               Boolean                   @default(false)
  notificationConsentAt DateTime?                 @map("notification_consent_at") @db.Timestamptz(6)
  localTime             String                    @default("08:00") @map("local_time") @db.VarChar(5)
  timezone              String                    @default("Asia/Tokyo") @db.VarChar(64)
  frequency             LineNotificationFrequency @default(DAILY)
  quietHoursStart       String                    @default("21:00") @map("quiet_hours_start") @db.VarChar(5)
  quietHoursEnd         String                    @default("07:00") @map("quiet_hours_end") @db.VarChar(5)
  pausedUntil           DateTime?                 @map("paused_until") @db.Timestamptz(6)
  reminderEnabled       Boolean                   @default(false) @map("reminder_enabled")
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace             Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bunshin               Bunshin                   @relation(fields: [workspaceId, bunshinId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, userId, bunshinId])
  @@index([workspaceId, bunshinId, enabled])
  @@index([userId, enabled])
  @@map("line_notification_preferences")
}

model LineConnection {
  id                    String                       @id @default(uuid()) @db.Uuid
  environment           LineConfigurationEnvironment
  workspaceId           String                       @map("workspace_id") @db.Uuid
  userId                String                       @map("user_id") @db.Uuid
  providerUserId        String                       @map("provider_user_id") @db.VarChar(255)
  status                LineConnectionStatus         @default(ACTIVE)
  friendshipStatus      LineFriendshipStatus         @default(UNKNOWN) @map("friendship_status")
  notificationConsentAt DateTime?                    @map("notification_consent_at") @db.Timestamptz(6)
  followedAt            DateTime?                    @map("followed_at") @db.Timestamptz(6)
  unfollowedAt          DateTime?                    @map("unfollowed_at") @db.Timestamptz(6)
  lastWebhookAt         DateTime?                    @map("last_webhook_at") @db.Timestamptz(6)
  createdAt             DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace             Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user                  User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([environment, workspaceId, userId])
  @@index([environment, providerUserId, status, friendshipStatus])
  @@index([workspaceId, userId, status])
  @@map("line_connections")
}

model LineWebhookEvent {
  id              String                       @id @default(uuid()) @db.Uuid
  environment     LineConfigurationEnvironment
  providerEventId String                       @map("provider_event_id") @db.VarChar(255)
  type            LineWebhookEventType
  outcome         LineWebhookEventOutcome
  occurredAt      DateTime                     @map("occurred_at") @db.Timestamptz(6)
  processedAt     DateTime                     @default(now()) @map("processed_at") @db.Timestamptz(6)
  workspaceId     String?                      @map("workspace_id") @db.Uuid
  workspace       Workspace?                   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@unique([environment, providerEventId])
  @@index([environment, processedAt])
  @@index([workspaceId, processedAt])
  @@map("line_webhook_events")
}

model LegalDocument {
  id              String              @id @default(uuid()) @db.Uuid
  type            LegalDocumentType
  version         Int
  title           String              @db.VarChar(200)
  content         String              @db.Text
  status          LegalDocumentStatus @default(DRAFT)
  effectiveAt     DateTime?           @map("effective_at") @db.Timestamptz(6)
  publishedAt     DateTime?           @map("published_at") @db.Timestamptz(6)
  createdByUserId String              @map("created_by_user_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       User                @relation("LegalDocumentAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  consents        UserLegalConsent[]

  @@unique([type, version])
  @@index([type, status, publishedAt])
  @@map("legal_documents")
}

model UserLegalConsent {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  legalDocumentId String        @map("legal_document_id") @db.Uuid
  consentedAt     DateTime      @default(now()) @map("consented_at") @db.Timestamptz(6)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalDocument   LegalDocument @relation(fields: [legalDocumentId], references: [id], onDelete: Restrict)

  @@unique([userId, legalDocumentId])
  @@index([userId, consentedAt])
  @@index([legalDocumentId, consentedAt])
  @@map("user_legal_consents")
}

model AccountDeletionRequest {
  id                  String                          @id @default(uuid()) @db.Uuid
  userId              String                          @map("user_id") @db.Uuid
  status              AccountDeletionRequestStatus    @default(REQUESTED)
  requestedAt         DateTime                        @default(now()) @map("requested_at") @db.Timestamptz(6)
  scheduledFor        DateTime                        @map("scheduled_for") @db.Timestamptz(6)
  attemptCount        Int                             @default(0) @map("attempt_count")
  leaseOwner          String?                         @map("lease_owner") @db.VarChar(120)
  leaseExpiresAt      DateTime?                       @map("lease_expires_at") @db.Timestamptz(6)
  processingStartedAt DateTime?                       @map("processing_started_at") @db.Timestamptz(6)
  blockedReason       String?                         @map("blocked_reason") @db.VarChar(80)
  lastErrorCategory   String?                         @map("last_error_category") @db.VarChar(80)
  executionVersion    Int                             @default(1) @map("execution_version")
  summary             Json?
  cancelledAt         DateTime?                       @map("cancelled_at") @db.Timestamptz(6)
  completedAt         DateTime?                       @map("completed_at") @db.Timestamptz(6)
  createdAt           DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                User                            @relation(fields: [userId], references: [id], onDelete: Restrict)
  operationAudits     AccountDeletionOperationAudit[]

  @@index([userId, status, requestedAt])
  @@index([status, scheduledFor])
  @@index([status, leaseExpiresAt])
  @@map("account_deletion_requests")
}

model AccountDeletionOperationAudit {
  id             String                       @id @default(uuid()) @db.Uuid
  requestId      String                       @map("request_id") @db.Uuid
  actorUserId    String                       @map("actor_user_id") @db.Uuid
  action         String                       @db.VarChar(40)
  reason         String                       @db.VarChar(500)
  previousStatus AccountDeletionRequestStatus @map("previous_status")
  nextStatus     AccountDeletionRequestStatus @map("next_status")
  occurredAt     DateTime                     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  request        AccountDeletionRequest       @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor          User                         @relation("AccountDeletionAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([requestId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("account_deletion_operation_audits")
}

model Bunshin {
  id                          String                        @id @default(uuid()) @db.Uuid
  workspaceId                 String                        @map("workspace_id") @db.Uuid
  ownerUserId                 String                        @map("owner_user_id") @db.Uuid
  name                        String                        @db.VarChar(100)
  slug                        String                        @db.VarChar(80)
  type                        BunshinType
  status                      BunshinStatus                 @default(DRAFT)
  objectiveSummary            String                        @map("objective_summary") @db.VarChar(500)
  audienceSummary             String                        @map("audience_summary") @db.VarChar(500)
  personalitySummary          String                        @map("personality_summary") @db.VarChar(500)
  avatarUrl                   String?                       @map("avatar_url") @db.VarChar(2048)
  archivedAt                  DateTime?                     @map("archived_at") @db.Timestamptz(6)
