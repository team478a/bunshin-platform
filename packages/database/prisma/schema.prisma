model User {
  id                                String                              @id @default(uuid()) @db.Uuid
  status                            UserStatus                          @default(ACTIVE)
  displayName                       String                              @map("display_name") @db.VarChar(100)
  email                             String?                             @db.VarChar(320)
  createdAt                         DateTime                            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                         DateTime                            @updatedAt @map("updated_at") @db.Timestamptz(6)
  identities                        AuthIdentity[]
  memberships                       WorkspaceMembership[]
  groupMemberships                  GroupMembership[]
  groupInvitationsCreated           GroupInvitation[]                   @relation("GroupInvitationCreator")
  platformAdmin                     PlatformAdmin?
  platformAdminAuditsAsTarget       PlatformAdminAudit[]                @relation("PlatformAdminAuditTarget")
  platformAdminAuditsAsActor        PlatformAdminAudit[]                @relation("PlatformAdminAuditActor")
  bunshins                          Bunshin[]
  ownerKnowledge                    OwnerKnowledge[]                    @relation("KnowledgeOwner")
  knowledgeGrants                   BunshinKnowledgeGrant[]             @relation("GrantActor")
  capabilityAssignments             BunshinCapabilityAssignment[]       @relation("CapabilityAssignmentActor")
  missionActivities                 MissionActivity[]                   @relation("MissionActivityActor")
  postRecords                       PostRecord[]                        @relation("PostRecordActor")
  missionFeedback                   MissionFeedback[]                   @relation("MissionFeedbackActor")
  aiUsageEvents                     AiUsageEvent[]                      @relation("AiUsageActor")
  legalDocuments                    LegalDocument[]                     @relation("LegalDocumentAuthor")
  legalConsents                     UserLegalConsent[]
  accountDeletionRequests           AccountDeletionRequest[]
  accountDeletionAudits             AccountDeletionOperationAudit[]     @relation("AccountDeletionAuditActor")
  lineConfigurationAudits           LineConfigurationAudit[]            @relation("LineConfigurationAuditActor")
  groupLineRoutingPoliciesEdited    GroupLineRoutingPolicy[]            @relation("GroupLineRoutingPolicyEditor")
  groupLineConfigurationsCreated    GroupLineChannelConfiguration[]     @relation("GroupLineConfigurationCreator")
  groupLineConfigurationAudits      GroupLineConfigurationAudit[]       @relation("GroupLineConfigurationAuditActor")
  groupLineConnections              GroupLineConnection[]               @relation("GroupLineConnectionUser")
  lineRichMenuAudits                LineRichMenuAudit[]                 @relation("LineRichMenuAuditActor")
  aiProviderConfigurationAudits     AiProviderConfigurationAudit[]      @relation("AiProviderConfigurationAuditActor")
  adminEmailConfigurationAudits     AdminEmailConfigurationAudit[]      @relation("AdminEmailConfigurationAuditActor")
  lineNotificationPreferences       LineNotificationPreference[]
  lineConnections                   LineConnection[]
  jobs                              Job[]
  lineMessageDeliveries             LineMessageDelivery[]
  missionDeepLinkStates             MissionDeepLinkState[]
  lineDeliveryRetryRequests         LineDeliveryRetryRequest[]          @relation("LineDeliveryRetryActor")
  videoRenderRetryRequests          VideoRenderRetryRequest[]           @relation("VideoRenderRetryActor")
  videoDisclosurePoliciesCreated    VideoDisclosurePolicy[]             @relation("VideoDisclosurePolicyCreator")
  videoDisclosurePoliciesActivated  VideoDisclosurePolicy[]             @relation("VideoDisclosurePolicyActivator")
  trendBenchmarkCases               TrendProviderBenchmarkCase[]        @relation("TrendBenchmarkCaseAuthor")
  trendBenchmarkObservations        TrendProviderBenchmarkObservation[] @relation("TrendBenchmarkObservationEditor")
  productionGateEvidence            ProductionGateEvidence[]            @relation("ProductionGateEvidenceActor")
  userOperationAuditsAsTarget       UserOperationAudit[]                @relation("UserOperationAuditTarget")
  userOperationAuditsAsActor        UserOperationAudit[]                @relation("UserOperationAuditActor")
  supportCasesAsTarget              SupportCase[]                       @relation("SupportCaseTarget")
  supportCasesCreated               SupportCase[]                       @relation("SupportCaseCreator")
  supportCasesAssigned              SupportCase[]                       @relation("SupportCaseAssignee")
  supportCaseNotes                  SupportCaseNote[]
  personalityVersionsCreated        BunshinPersonalityVersion[]
  userEvidenceCreated               UserEvidence[]                      @relation("UserEvidenceCreator")
  advertisingSafetyReviews          AdvertisingSafetyReview[]           @relation("AdvertisingSafetyReviewActor")
  campaignsCreated                  Campaign[]                          @relation("CampaignCreator")
  campaignParticipations            CampaignParticipation[]
  campaignActivities                CampaignActivity[]                  @relation("CampaignActivityActor")
  externalTrackingSystemsCreated    ExternalTrackingSystem[]            @relation("ExternalTrackingSystemCreator")
  externalTrackingSystemsUpdated    ExternalTrackingSystem[]            @relation("ExternalTrackingSystemUpdater")
  externalTrackingDomainsCreated    ExternalTrackingAllowedDomain[]     @relation("ExternalTrackingDomainCreator")
  externalTrackingDomainsUpdated    ExternalTrackingAllowedDomain[]     @relation("ExternalTrackingDomainUpdater")
  externalTrackingIdentitiesCreated ExternalTrackingMemberIdentity[]    @relation("ExternalTrackingIdentityCreator")
  externalTrackingIdentitiesUpdated ExternalTrackingMemberIdentity[]    @relation("ExternalTrackingIdentityUpdater")
  externalTrackingLinksCreated      ExternalTrackingLink[]              @relation("ExternalTrackingLinkCreator")
  externalTrackingLinksUpdated      ExternalTrackingLink[]              @relation("ExternalTrackingLinkUpdater")
  externalTrackingAuditsPerformed   ExternalTrackingAuditLog[]          @relation("ExternalTrackingAuditActor")
  externalLinkPlacementsCreated     ExternalLinkPlacementTemplate[]     @relation("ExternalLinkPlacementCreator")
  externalLinkPlacementsUpdated     ExternalLinkPlacementTemplate[]     @relation("ExternalLinkPlacementUpdater")
  contentLinkUsages                 ContentLinkUsage[]                  @relation("ContentLinkUsageUser")
  groupFeaturePoliciesSet           GroupFeaturePolicy[]                @relation("GroupFeaturePolicyActor")
  groupFeatureAssignmentsSet        GroupMemberFeatureAssignment[]      @relation("GroupMemberFeatureAssignmentActor")
  groupFeatureAuditsPerformed       GroupFeatureAuditLog[]              @relation("GroupFeatureAuditActor")
  groupMembershipAuditsPerformed    GroupMembershipAuditLog[]           @relation("GroupMembershipAuditActor")
  groupFeatureUsageEvents           GroupFeatureUsageEvent[]            @relation("GroupFeatureUsageActor")
  achievementBadges                 AchievementBadge[]
  activityMetricExclusionsAsTarget  ActivityMetricExclusion[]           @relation("ActivityMetricExclusionTarget")
  activityMetricExclusionsAsActor   ActivityMetricExclusion[]           @relation("ActivityMetricExclusionActor")
  activityContinuityRulesCreated    ActivityContinuityRule[]            @relation("ActivityContinuityRuleCreator")
  activityContinuityRulesActivated  ActivityContinuityRule[]            @relation("ActivityContinuityRuleActivator")
  videoProjects                     VideoProject[]                      @relation("VideoProjectOwner")
  videoAssets                       VideoAsset[]                        @relation("VideoAssetOwner")
  pointAccounts                     PointAccount[]
  pointTransactions                 PointTransaction[]
  pointProcessingEvents             PointProcessingEvent[]
  pointRedemptions                  PointRedemption[]
  badgeProgress                     BadgeProgress[]
  badgeAwards                       BadgeAward[]
  badgeAwardVisibilities            BadgeAwardVisibility[]
  badgeProcessingEvents             BadgeProcessingEvent[]
  badgeAuditsPerformed              BadgeAdminAuditLog[]                @relation("BadgeAuditActor")
  badgeApprovalsRequested           BadgeApprovalRequest[]              @relation("BadgeApprovalRequester")
  badgeApprovalsReviewed            BadgeApprovalRequest[]              @relation("BadgeApprovalReviewer")
  badgeCandidates                   BadgeAwardCandidate[]               @relation("BadgeCandidateUser")
  badgeCandidatesNominated          BadgeAwardCandidate[]               @relation("BadgeCandidateNominator")
  badgeCandidatesReviewed           BadgeAwardCandidate[]               @relation("BadgeCandidateReviewer")

  @@index([status])
  @@map("users")
}

model AuthIdentity {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  provider       AuthProvider
  providerUserId String       @map("provider_user_id") @db.VarChar(255)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

