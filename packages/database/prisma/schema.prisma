model User {
  id                                String                              @id @default(uuid()) @db.Uuid
  status                            UserStatus                          @default(ACTIVE)
  displayName                       String                              @map("display_name") @db.VarChar(100)
  email                             String?                             @db.VarChar(320)
  createdAt                         DateTime                            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                         DateTime                            @updatedAt @map("updated_at") @db.Timestamptz(6)
  identities                        AuthIdentity[]
  memberships                       WorkspaceMembership[]
  groupMemberships                  GroupMembership[]
  groupInvitationsCreated           GroupInvitation[]                   @relation("GroupInvitationCreator")
  platformAdmin                     PlatformAdmin?
  platformAdminAuditsAsTarget       PlatformAdminAudit[]                @relation("PlatformAdminAuditTarget")
  platformAdminAuditsAsActor        PlatformAdminAudit[]                @relation("PlatformAdminAuditActor")
  bunshins                          Bunshin[]
  ownerKnowledge                    OwnerKnowledge[]                    @relation("KnowledgeOwner")
  knowledgeGrants                   BunshinKnowledgeGrant[]             @relation("GrantActor")
  capabilityAssignments             BunshinCapabilityAssignment[]       @relation("CapabilityAssignmentActor")
  missionActivities                 MissionActivity[]                   @relation("MissionActivityActor")
  postRecords                       PostRecord[]                        @relation("PostRecordActor")
  missionFeedback                   MissionFeedback[]                   @relation("MissionFeedbackActor")
  aiUsageEvents                     AiUsageEvent[]                      @relation("AiUsageActor")
  legalDocuments                    LegalDocument[]                     @relation("LegalDocumentAuthor")
  legalConsents                     UserLegalConsent[]
  accountDeletionRequests           AccountDeletionRequest[]
  accountDeletionAudits             AccountDeletionOperationAudit[]     @relation("AccountDeletionAuditActor")
  lineConfigurationAudits           LineConfigurationAudit[]            @relation("LineConfigurationAuditActor")
  lineRichMenuAudits                LineRichMenuAudit[]                 @relation("LineRichMenuAuditActor")
  aiProviderConfigurationAudits     AiProviderConfigurationAudit[]      @relation("AiProviderConfigurationAuditActor")
  adminEmailConfigurationAudits     AdminEmailConfigurationAudit[]      @relation("AdminEmailConfigurationAuditActor")
  lineNotificationPreferences       LineNotificationPreference[]
  lineConnections                   LineConnection[]
  jobs                              Job[]
  lineMessageDeliveries             LineMessageDelivery[]
  missionDeepLinkStates             MissionDeepLinkState[]
  lineDeliveryRetryRequests         LineDeliveryRetryRequest[]          @relation("LineDeliveryRetryActor")
  trendBenchmarkCases               TrendProviderBenchmarkCase[]        @relation("TrendBenchmarkCaseAuthor")
  trendBenchmarkObservations        TrendProviderBenchmarkObservation[] @relation("TrendBenchmarkObservationEditor")
  productionGateEvidence            ProductionGateEvidence[]            @relation("ProductionGateEvidenceActor")
  userOperationAuditsAsTarget       UserOperationAudit[]                @relation("UserOperationAuditTarget")
  userOperationAuditsAsActor        UserOperationAudit[]                @relation("UserOperationAuditActor")
  supportCasesAsTarget              SupportCase[]                       @relation("SupportCaseTarget")
  supportCasesCreated               SupportCase[]                       @relation("SupportCaseCreator")
  supportCasesAssigned              SupportCase[]                       @relation("SupportCaseAssignee")
  supportCaseNotes                  SupportCaseNote[]
  personalityVersionsCreated        BunshinPersonalityVersion[]
  userEvidenceCreated               UserEvidence[]                      @relation("UserEvidenceCreator")
  advertisingSafetyReviews          AdvertisingSafetyReview[]           @relation("AdvertisingSafetyReviewActor")
  campaignsCreated                  Campaign[]                          @relation("CampaignCreator")
  campaignParticipations            CampaignParticipation[]
  campaignActivities                CampaignActivity[]                  @relation("CampaignActivityActor")
  externalTrackingSystemsCreated    ExternalTrackingSystem[]            @relation("ExternalTrackingSystemCreator")
  externalTrackingSystemsUpdated    ExternalTrackingSystem[]            @relation("ExternalTrackingSystemUpdater")
  externalTrackingDomainsCreated    ExternalTrackingAllowedDomain[]     @relation("ExternalTrackingDomainCreator")
  externalTrackingDomainsUpdated    ExternalTrackingAllowedDomain[]     @relation("ExternalTrackingDomainUpdater")
  externalTrackingIdentitiesCreated ExternalTrackingMemberIdentity[]    @relation("ExternalTrackingIdentityCreator")
  externalTrackingIdentitiesUpdated ExternalTrackingMemberIdentity[]    @relation("ExternalTrackingIdentityUpdater")
  externalTrackingLinksCreated      ExternalTrackingLink[]              @relation("ExternalTrackingLinkCreator")
  externalTrackingLinksUpdated      ExternalTrackingLink[]              @relation("ExternalTrackingLinkUpdater")
  externalTrackingAuditsPerformed   ExternalTrackingAuditLog[]          @relation("ExternalTrackingAuditActor")
  externalLinkPlacementsCreated     ExternalLinkPlacementTemplate[]     @relation("ExternalLinkPlacementCreator")
  externalLinkPlacementsUpdated     ExternalLinkPlacementTemplate[]     @relation("ExternalLinkPlacementUpdater")
  contentLinkUsages                 ContentLinkUsage[]                  @relation("ContentLinkUsageUser")
  groupFeaturePoliciesSet           GroupFeaturePolicy[]                @relation("GroupFeaturePolicyActor")
  groupFeatureAssignmentsSet        GroupMemberFeatureAssignment[]      @relation("GroupMemberFeatureAssignmentActor")
  groupFeatureAuditsPerformed       GroupFeatureAuditLog[]              @relation("GroupFeatureAuditActor")
  groupMembershipAuditsPerformed    GroupMembershipAuditLog[]           @relation("GroupMembershipAuditActor")

  @@index([status])
  @@map("users")
}

model AuthIdentity {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  provider       AuthProvider
  providerUserId String       @map("provider_user_id") @db.VarChar(255)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

model Workspace {
  id                          String                           @id @default(uuid()) @db.Uuid
  type                        WorkspaceType
  name                        String                           @db.VarChar(120)
  status                      WorkspaceStatus                  @default(ACTIVE)
  createdAt                   DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships                 WorkspaceMembership[]
  groups                      Group[]
  groupMemberships            GroupMembership[]
  groupInvitations            GroupInvitation[]
  productPacks                ProductPack[]
  productPackAssignments      ProductPackAssignment[]
  bunshins                    Bunshin[]
  ownerKnowledge              OwnerKnowledge[]
  knowledgeGrants             BunshinKnowledgeGrant[]
  memories                    BunshinMemory[]
  capabilityAssignments       BunshinCapabilityAssignment[]
  socialProfiles              SocialProfile[]
  socialAccountStrategies     SocialAccountStrategy[]
  contentPillars              ContentPillar[]
  weeklyPlans                 WeeklyPlan[]
  weeklyPlanItems             WeeklyPlanItem[]
  dailyMissions               DailyMission[]
  missionContents             MissionContent[]
  missionDecisions            MissionDecision[]
  missionActivities           MissionActivity[]
  postRecords                 PostRecord[]
  missionFeedback             MissionFeedback[]
  aiUsageEvents               AiUsageEvent[]
  lineNotificationPreferences LineNotificationPreference[]
  lineConnections             LineConnection[]
  lineWebhookEvents           LineWebhookEvent[]
  jobs                        Job[]
  lineMessageDeliveries       LineMessageDelivery[]
  missionDeepLinkStates       MissionDeepLinkState[]
  trendResearchRuns           TrendResearchRun[]
  trendEvidence               TrendEvidence[]
  trendIdeaCandidates         TrendIdeaCandidate[]
  missionTrendContexts        MissionTrendContext[]
  generationContextSnapshots  GenerationContextSnapshot[]
  personalityVersions         BunshinPersonalityVersion[]
  userEvidence                UserEvidence[]
  advertisingSafetyReviews    AdvertisingSafetyReview[]
  campaignsOwned              Campaign[]                       @relation("CampaignOwnerWorkspace")
  campaignParticipations      CampaignParticipation[]          @relation("CampaignParticipantWorkspace")
  campaignSimilarityReviews   CampaignSimilarityReview[]
  externalTrackingSystems     ExternalTrackingSystem[]
  externalTrackingDomains     ExternalTrackingAllowedDomain[]
  externalTrackingIdentities  ExternalTrackingMemberIdentity[]
  externalTrackingLinks       ExternalTrackingLink[]
  externalTrackingAudits      ExternalTrackingAuditLog[]
  externalLinkPlacements      ExternalLinkPlacementTemplate[]
  contentLinkUsages           ContentLinkUsage[]
  groupFeaturePolicies        GroupFeaturePolicy[]
  groupFeatureAssignments     GroupMemberFeatureAssignment[]
  groupFeatureAudits          GroupFeatureAuditLog[]
  groupMembershipAudits       GroupMembershipAuditLog[]

  @@index([status])
  @@map("workspaces")
}

model WorkspaceMembership {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  role        WorkspaceRole
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, status])
  @@map("workspace_memberships")
}

model Group {
  id                         String                           @id @default(uuid()) @db.Uuid
  workspaceId                String                           @map("workspace_id") @db.Uuid
  name                       String                           @db.VarChar(120)
  status                     GroupStatus                      @default(ACTIVE)
  createdAt                  DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace                  Workspace                        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships                GroupMembership[]
  invitations                GroupInvitation[]
  productPacks               ProductPack[]
  campaigns                  Campaign[]
  externalTrackingSystems    ExternalTrackingSystem[]
  externalTrackingDomains    ExternalTrackingAllowedDomain[]
  externalTrackingIdentities ExternalTrackingMemberIdentity[]
  externalTrackingLinks      ExternalTrackingLink[]
  externalTrackingAudits     ExternalTrackingAuditLog[]
  externalLinkPlacements     ExternalLinkPlacementTemplate[]
  contentLinkUsages          ContentLinkUsage[]
  featurePolicies            GroupFeaturePolicy[]
  featureAssignments         GroupMemberFeatureAssignment[]
  featureAudits              GroupFeatureAuditLog[]
  membershipAudits           GroupMembershipAuditLog[]

  @@unique([workspaceId, name])
  @@index([workspaceId, status])
  @@map("groups")
}

model GroupMembership {
  id                         String                           @id @default(uuid()) @db.Uuid
  workspaceId                String                           @map("workspace_id") @db.Uuid
  groupId                    String                           @map("group_id") @db.Uuid
  userId                     String                           @map("user_id") @db.Uuid
  role                       GroupRole                        @default(PARTICIPANT)
  status                     GroupMembershipStatus            @default(INVITED)
  consentedAt                DateTime?                        @map("consented_at") @db.Timestamptz(6)
  declinedAt                 DateTime?                        @map("declined_at") @db.Timestamptz(6)
  revokedAt                  DateTime?                        @map("revoked_at") @db.Timestamptz(6)
  createdAt                  DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace                  Workspace                        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  group                      Group                            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user                       User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalTrackingIdentities ExternalTrackingMemberIdentity[]
  contentLinkUsages          ContentLinkUsage[]
  featureAssignments         GroupMemberFeatureAssignment[]
  featureAudits              GroupFeatureAuditLog[]
  membershipAudits           GroupMembershipAuditLog[]

  @@unique([groupId, userId])
  @@index([workspaceId, userId, status])
  @@index([groupId, status])
  @@map("group_memberships")
}

model GroupMembershipAuditLog {
  id                String                     @id @default(uuid()) @db.Uuid
  workspaceId       String                     @map("workspace_id") @db.Uuid
  groupId           String                     @map("group_id") @db.Uuid
  groupMembershipId String?                    @map("group_membership_id") @db.Uuid
  action            GroupMembershipAuditAction
  beforeData        Json                       @map("before_data")
  afterData         Json                       @map("after_data")
  reason            String                     @db.VarChar(1000)
  performedByUserId String                     @map("performed_by_user_id") @db.Uuid
  occurredAt        DateTime                   @default(now()) @map("occurred_at") @db.Timestamptz(6)
  workspace         Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  group             Group                      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupMembership   GroupMembership?           @relation(fields: [groupMembershipId], references: [id], onDelete: SetNull)
  performedByUser   User                       @relation("GroupMembershipAuditActor", fields: [performedByUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId, groupId, occurredAt])
  @@index([groupMembershipId, occurredAt])
  @@map("group_membership_audit_logs")
}

model GroupInvitation {
  id              String                @id @default(uuid()) @db.Uuid
  workspaceId     String                @map("workspace_id") @db.Uuid
  groupId         String                @map("group_id") @db.Uuid
  tokenHash       String                @unique @map("token_hash") @db.Char(64)
  role            GroupRole             @default(PARTICIPANT)
  status          GroupInvitationStatus @default(ACTIVE)
  expiresAt       DateTime              @map("expires_at") @db.Timestamptz(6)
  maxUses         Int                   @default(1) @map("max_uses")
  usedCount       Int                   @default(0) @map("used_count")
  createdByUserId String                @map("created_by_user_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace       Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  group           Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy       User                  @relation("GroupInvitationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId, groupId, status])
  @@index([expiresAt, status])
  @@map("group_invitations")
}

model FeatureDefinition {
  key               String                         @id @db.VarChar(120)
  parentKey         String?                        @map("parent_key") @db.VarChar(120)
  name              String                         @db.VarChar(160)
  description       String                         @db.VarChar(1000)
  status            FeatureDefinitionStatus        @default(ACTIVE)
  configSchema      Json                           @default("{}") @map("config_schema")
  createdAt         DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent            FeatureDefinition?             @relation("FeatureHierarchy", fields: [parentKey], references: [key], onDelete: Restrict)
  children          FeatureDefinition[]            @relation("FeatureHierarchy")
  groupPolicies     GroupFeaturePolicy[]
  memberAssignments GroupMemberFeatureAssignment[]
  audits            GroupFeatureAuditLog[]

  @@index([parentKey, status])
  @@map("feature_definitions")
}

model GroupFeaturePolicy {
  id           String                   @id @default(uuid()) @db.Uuid
  workspaceId  String                   @map("workspace_id") @db.Uuid
  groupId      String                   @map("group_id") @db.Uuid
  featureKey   String                   @map("feature_key") @db.VarChar(120)
  status       GroupFeatureAccessStatus @default(DISABLED)
  dailyLimit   Int?                     @map("daily_limit")
  monthlyLimit Int?                     @map("monthly_limit")
  config       Json                     @default("{}")
