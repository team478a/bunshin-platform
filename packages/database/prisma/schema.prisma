  preferredExpressions Json               @map("preferred_expressions")
  visualDirection      String?            @map("visual_direction") @db.VarChar(500)
  facePolicy           FacePolicy         @map("face_policy")
  createdByUserId      String             @map("created_by_user_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  bunshin              Bunshin            @relation(fields: [workspaceId, bunshinId], references: [workspaceId, id], onDelete: Restrict)
  personality          BunshinPersonality @relation(fields: [personalityId], references: [id], onDelete: Restrict)
  createdBy            User               @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([personalityId, version])
  @@unique([workspaceId, bunshinId, id])
  @@index([workspaceId, bunshinId, version])
  @@index([createdByUserId, createdAt])
  @@map("bunshin_personality_versions")
}

model LineMessageDelivery {
  id                String                       @id @default(uuid()) @db.Uuid
  environment       LineConfigurationEnvironment
  workspaceId       String                       @map("workspace_id") @db.Uuid
  bunshinId         String                       @map("bunshin_id") @db.Uuid
  userId            String                       @map("user_id") @db.Uuid
  dailyMissionId    String                       @map("daily_mission_id") @db.Uuid
  kind              LineMessageKind              @default(DAILY_MISSION)
  status            LineMessageDeliveryStatus    @default(PENDING)
  idempotencyKey    String                       @map("idempotency_key") @db.VarChar(200)
  scheduledAt       DateTime                     @default(now()) @map("scheduled_at") @db.Timestamptz(6)
  sentAt            DateTime?                    @map("sent_at") @db.Timestamptz(6)
  cancelledAt       DateTime?                    @map("cancelled_at") @db.Timestamptz(6)
  lastErrorCategory String?                      @map("last_error_category") @db.VarChar(80)
  attemptCount      Int                          @default(0) @map("attempt_count")
  leaseOwner        String?                      @map("lease_owner") @db.VarChar(100)
  leaseExpiresAt    DateTime?                    @map("lease_expires_at") @db.Timestamptz(6)
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace         Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  bunshin           Bunshin                      @relation(fields: [workspaceId, bunshinId], references: [workspaceId, id], onDelete: Restrict)
  user              User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  dailyMission      DailyMission                 @relation(fields: [workspaceId, bunshinId, dailyMissionId], references: [workspaceId, bunshinId, id], onDelete: Restrict)
  attempts          LineMessageDeliveryAttempt[]
  retryRequests     LineDeliveryRetryRequest[]

  @@unique([environment, idempotencyKey])
  @@unique([environment, userId, dailyMissionId, kind])
  @@index([environment, status, scheduledAt])
  @@index([environment, status, leaseExpiresAt])
  @@index([workspaceId, bunshinId, createdAt])
  @@map("line_message_deliveries")
}

model LineDeliveryRetryRequest {
  id                   String                       @id @db.Uuid
  environment          LineConfigurationEnvironment
  deliveryId           String                       @map("delivery_id") @db.Uuid
  deliveryAttemptCount Int                          @map("delivery_attempt_count")
  actorUserId          String                       @map("actor_user_id") @db.Uuid
  reason               String                       @db.VarChar(500)
  jobId                String                       @unique @map("job_id") @db.Uuid
  createdAt            DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  delivery             LineMessageDelivery          @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  actor                User                         @relation("LineDeliveryRetryActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  job                  Job                          @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@unique([deliveryId, deliveryAttemptCount])
  @@index([environment, createdAt])
  @@index([actorUserId, createdAt])
  @@map("line_delivery_retry_requests")
}

model LineMessageDeliveryAttempt {
  id            String                   @id @default(uuid()) @db.Uuid
  deliveryId    String                   @map("delivery_id") @db.Uuid
  attemptNumber Int                      @map("attempt_number")
  status        LineMessageAttemptStatus
  errorCategory String?                  @map("error_category") @db.VarChar(80)
  latencyMs     Int                      @map("latency_ms")
  attemptedAt   DateTime                 @default(now()) @map("attempted_at") @db.Timestamptz(6)
  delivery      LineMessageDelivery      @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, attemptNumber])
  @@index([status, attemptedAt])
  @@map("line_message_delivery_attempts")
}

model MissionDeepLinkState {
  id             String                       @id @db.Uuid
  environment    LineConfigurationEnvironment
  workspaceId    String                       @map("workspace_id") @db.Uuid
  bunshinId      String                       @map("bunshin_id") @db.Uuid
  userId         String                       @map("user_id") @db.Uuid
  dailyMissionId String                       @map("daily_mission_id") @db.Uuid
  keyVersion     Int                          @map("key_version")
  expiresAt      DateTime                     @map("expires_at") @db.Timestamptz(6)
  consumedAt     DateTime?                    @map("consumed_at") @db.Timestamptz(6)
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace      Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  bunshin        Bunshin                      @relation(fields: [workspaceId, bunshinId], references: [workspaceId, id], onDelete: Restrict)
  user           User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyMission   DailyMission                 @relation(fields: [workspaceId, bunshinId, dailyMissionId], references: [workspaceId, bunshinId, id], onDelete: Cascade)

  @@index([environment, expiresAt, consumedAt])
  @@index([workspaceId, userId, createdAt])
  @@map("mission_deep_link_states")
}
