generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AuthProvider {
  LINE
  EMAIL
}

enum WorkspaceType {
  PERSONAL
  ORGANIZATION
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum PlatformRole {
  SUPER_ADMIN
  OPERATOR
  SUPPORT
  READ_ONLY
}

enum PlatformAdminStatus {
  ACTIVE
  REVOKED
}

enum BunshinType {
  COPY
  EXPERT
  BRAND
  CHARACTER
}

enum BunshinStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ObjectiveStatus {
  ACTIVE
  INACTIVE
}

enum FacePolicy {
  FACE_OK
  FACE_NG_VOICE_OK
  FACE_VOICE_NG
  FULL_ANONYMOUS
}

enum OwnerKnowledgeType {
  PROFILE
  EXPERIENCE
  SKILL
  PRODUCT
  FAQ
  CASE
  ASSET
  OTHER
}

enum KnowledgeSourceType {
  MANUAL
  IMPORT
  SYSTEM
}

enum OwnerKnowledgeStatus {
  ACTIVE
  ARCHIVED
}

enum KnowledgeGrantStatus {
  ACTIVE
  REVOKED
}

enum BunshinMemoryType {
  BELIEF
  EXPERIENCE
  KNOWLEDGE
  STORY
  FAQ
  OPINION
  PREFERENCE
  PERFORMANCE_INSIGHT
}

enum BunshinMemorySourceType {
  USER_INPUT
  MISSION_FEEDBACK
  PERFORMANCE
  IMPORT
  SYSTEM
}

enum CapabilityType {
  SOCIAL
  BLOG
  LINE_MARKETING
  LP
  LEAD_GENERATION
  SALES
  CUSTOMER_SUPPORT
}

enum CapabilityAssignmentStatus {
  ACTIVE
  SUSPENDED
  LOCKED
}

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  X
  OTHER
}

enum SocialPostingFrequency {
  DAILY
  WEEKDAYS
  THREE_PER_WEEK
  WEEKLY
  FLEXIBLE
}

enum SocialProfileStatus {
  ACTIVE
  INACTIVE
}

enum WeeklyPlanStatus {
  DRAFT
  CONFIRMED
  EXPIRED
}

enum DailyMissionStatus {
  GENERATED
  VIEWED
  STARTED
  COMPLETED
  SKIPPED
  EXPIRED
}

enum SocialPreferredFormat {
  SLIDE
  LIVE_ACTION
  AI_VIDEO_PROMPT
  IMAGE
}

model User {
  id                    String                        @id @default(uuid()) @db.Uuid
  status                UserStatus                    @default(ACTIVE)
  displayName           String                        @map("display_name") @db.VarChar(100)
  email                 String?                       @db.VarChar(320)
  createdAt             DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  identities            AuthIdentity[]
  memberships           WorkspaceMembership[]
  platformAdmin         PlatformAdmin?
  bunshins              Bunshin[]
  ownerKnowledge        OwnerKnowledge[]              @relation("KnowledgeOwner")
  knowledgeGrants       BunshinKnowledgeGrant[]       @relation("GrantActor")
  capabilityAssignments BunshinCapabilityAssignment[] @relation("CapabilityAssignmentActor")

  @@index([status])
  @@map("users")
}

model AuthIdentity {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  provider       AuthProvider
  providerUserId String       @map("provider_user_id") @db.VarChar(255)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

model Workspace {
  id                    String                        @id @default(uuid()) @db.Uuid
  type                  WorkspaceType
  name                  String                        @db.VarChar(120)
  status                WorkspaceStatus               @default(ACTIVE)
  createdAt             DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships           WorkspaceMembership[]
  bunshins              Bunshin[]
  ownerKnowledge        OwnerKnowledge[]
  knowledgeGrants       BunshinKnowledgeGrant[]
  memories              BunshinMemory[]
  capabilityAssignments BunshinCapabilityAssignment[]
  socialProfiles        SocialProfile[]
  contentPillars        ContentPillar[]
  weeklyPlans           WeeklyPlan[]
  weeklyPlanItems       WeeklyPlanItem[]
  dailyMissions         DailyMission[]
  missionContents       MissionContent[]

  @@index([status])
  @@map("workspaces")
}

model WorkspaceMembership {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  role        WorkspaceRole
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, status])
  @@map("workspace_memberships")
}

model PlatformAdmin {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @unique @map("user_id") @db.Uuid
  role      PlatformRole
  status    PlatformAdminStatus @default(ACTIVE)
  grantedAt DateTime            @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt DateTime?           @map("revoked_at") @db.Timestamptz(6)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, role])
  @@map("platform_admins")
}

model Bunshin {
  id                    String                        @id @default(uuid()) @db.Uuid
  workspaceId           String                        @map("workspace_id") @db.Uuid
  ownerUserId           String                        @map("owner_user_id") @db.Uuid
  name                  String                        @db.VarChar(100)
  slug                  String                        @db.VarChar(80)
  type                  BunshinType
  status                BunshinStatus                 @default(DRAFT)
  objectiveSummary      String                        @map("objective_summary") @db.VarChar(500)
  audienceSummary       String                        @map("audience_summary") @db.VarChar(500)
  personalitySummary    String                        @map("personality_summary") @db.VarChar(500)
  avatarUrl             String?                       @map("avatar_url") @db.VarChar(2048)
  archivedAt            DateTime?                     @map("archived_at") @db.Timestamptz(6)
  createdAt             DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace             Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  ownerUser             User                          @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  objectives            BunshinObjective[]
  audiences             BunshinAudience[]
  personality           BunshinPersonality?
  knowledgeGrants       BunshinKnowledgeGrant[]
  memories              BunshinMemory[]
  capabilityAssignments BunshinCapabilityAssignment[]
  socialProfiles        SocialProfile[]
  contentPillars        ContentPillar[]
  weeklyPlans           WeeklyPlan[]
  weeklyPlanItems       WeeklyPlanItem[]
  dailyMissions         DailyMission[]
  missionContents       MissionContent[]

  @@unique([workspaceId, slug])
  @@unique([workspaceId, id])
  @@index([workspaceId, status, updatedAt])
  @@index([ownerUserId, status])
  @@map("bunshins")
}

model OwnerKnowledge {
  id          String                  @id @default(uuid()) @db.Uuid
  workspaceId String                  @map("workspace_id") @db.Uuid
  ownerUserId String                  @map("owner_user_id") @db.Uuid
  type        OwnerKnowledgeType
  title       String                  @db.VarChar(160)
  content     String                  @db.VarChar(20000)
  sourceType  KnowledgeSourceType     @default(MANUAL) @map("source_type")
  status      OwnerKnowledgeStatus    @default(ACTIVE)
  archivedAt  DateTime?               @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  ownerUser   User                    @relation("KnowledgeOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  grants      BunshinKnowledgeGrant[]

  @@index([workspaceId, ownerUserId, status, updatedAt])
  @@map("owner_knowledge")
}

model BunshinKnowledgeGrant {
  id               String               @id @default(uuid()) @db.Uuid
  workspaceId      String               @map("workspace_id") @db.Uuid
  bunshinId        String               @map("bunshin_id") @db.Uuid
  ownerKnowledgeId String               @map("owner_knowledge_id") @db.Uuid
  grantedByUserId  String               @map("granted_by_user_id") @db.Uuid
  status           KnowledgeGrantStatus @default(ACTIVE)
  grantedAt        DateTime             @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt        DateTime?            @map("revoked_at") @db.Timestamptz(6)
  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  bunshin          Bunshin              @relation(fields: [bunshinId], references: [id], onDelete: Restrict)
  ownerKnowledge   OwnerKnowledge       @relation(fields: [ownerKnowledgeId], references: [id], onDelete: Restrict)
  grantedByUser    User                 @relation("GrantActor", fields: [grantedByUserId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, bunshinId, ownerKnowledgeId])
  @@index([bunshinId, status])
  @@index([ownerKnowledgeId, status])
  @@map("bunshin_knowledge_grants")
}

model BunshinMemory {
  id          String                  @id @default(uuid()) @db.Uuid
  workspaceId String                  @map("workspace_id") @db.Uuid
  bunshinId   String                  @map("bunshin_id") @db.Uuid
  type        BunshinMemoryType
  content     String                  @db.VarChar(20000)
  summary     String?                 @db.VarChar(1000)
  sourceType  BunshinMemorySourceType @default(USER_INPUT) @map("source_type")
  sourceId    String?                 @map("source_id") @db.VarChar(255)
  confidence  Decimal                 @db.Decimal(4, 3)
  importance  Int
  active      Boolean                 @default(true)
  deletedAt   DateTime?               @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  bunshin     Bunshin                 @relation(fields: [bunshinId], references: [id], onDelete: Restrict)

  @@index([workspaceId, bunshinId, active, deletedAt, updatedAt])
  @@map("bunshin_memories")
}

model BunshinCapabilityAssignment {
  id               String                     @id @default(uuid()) @db.Uuid
  workspaceId      String                     @map("workspace_id") @db.Uuid
  bunshinId        String                     @map("bunshin_id") @db.Uuid
  capabilityType   CapabilityType             @map("capability_type")
  status           CapabilityAssignmentStatus @default(ACTIVE)
  config           Json                       @default("{}")
  assignedByUserId String                     @map("assigned_by_user_id") @db.Uuid
  activatedAt      DateTime                   @default(now()) @map("activated_at") @db.Timestamptz(6)
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace        Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  bunshin          Bunshin                    @relation(fields: [bunshinId], references: [id], onDelete: Restrict)
  assignedByUser   User                       @relation("CapabilityAssignmentActor", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, bunshinId, capabilityType])
  @@index([workspaceId, bunshinId, status, updatedAt])
  @@map("bunshin_capability_assignments")
}

model SocialProfile {
  id               String                 @id @default(uuid()) @db.Uuid
  workspaceId      String                 @map("workspace_id") @db.Uuid
  bunshinId        String                 @map("bunshin_id") @db.Uuid
  platform         SocialPlatform
  handle           String?                @db.VarChar(100)
  profileUrl       String?                @map("profile_url") @db.VarChar(2048)
  purpose          String                 @db.VarChar(500)
  postingFrequency SocialPostingFrequency @map("posting_frequency")
  preferredFormats Json                   @map("preferred_formats")
  status           SocialProfileStatus    @default(ACTIVE)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  bunshin          Bunshin                @relation(fields: [workspaceId, bunshinId], references: [workspaceId, id], onDelete: Restrict)
  dailyMissions    DailyMission[]

  @@unique([workspaceId, bunshinId, platform])
  @@unique([workspaceId, bunshinId, id])
  @@index([workspaceId, bunshinId, status, updatedAt])
  @@map("social_profiles")
}

model ContentPillar {
  id              String           @id @default(uuid()) @db.Uuid
  workspaceId     String           @map("workspace_id") @db.Uuid
  bunshinId       String           @map("bunshin_id") @db.Uuid
  title           String           @db.VarChar(100)
  description     String?          @db.VarChar(500)
  weight          Int
  active          Boolean          @default(true)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  bunshin         Bunshin          @relation(fields: [workspaceId, bunshinId], references: [workspaceId, id], onDelete: Restrict)
  weeklyPlanItems WeeklyPlanItem[]

  @@unique([workspaceId, bunshinId, title])
  @@unique([workspaceId, bunshinId, id])
  @@index([workspaceId, bunshinId, active, deletedAt, createdAt])
  @@map("content_pillars")
}

model WeeklyPlan {
  id              String           @id @default(uuid()) @db.Uuid
  workspaceId     String           @map("workspace_id") @db.Uuid
  bunshinId       String           @map("bunshin_id") @db.Uuid
  weekStartDate   DateTime         @map("week_start_date") @db.Date
  timezone        String           @db.VarChar(64)
  strategySummary String?          @map("strategy_summary") @db.VarChar(1000)
  status          WeeklyPlanStatus @default(DRAFT)
  confirmedAt     DateTime?        @map("confirmed_at") @db.Timestamptz(6)
  expiredAt       DateTime?        @map("expired_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  bunshin         Bunshin          @relation(fields: [workspaceId, bunshinId], references: [workspaceId, id], onDelete: Restrict)
  items           WeeklyPlanItem[]

  @@unique([workspaceId, bunshinId, weekStartDate])
  @@unique([workspaceId, bunshinId, id])
  @@index([workspaceId, bunshinId, status, weekStartDate])
  @@map("weekly_plans")
}

model WeeklyPlanItem {
  id                String                @id @default(uuid()) @db.Uuid
  workspaceId       String                @map("workspace_id") @db.Uuid
  bunshinId         String                @map("bunshin_id") @db.Uuid
  weeklyPlanId      String                @map("weekly_plan_id") @db.Uuid
  scheduledDate     DateTime              @map("scheduled_date") @db.Date
  contentPillarId   String                @map("content_pillar_id") @db.Uuid
  goal              String                @db.VarChar(200)
  angle             String                @db.VarChar(500)
  recommendedFormat SocialPreferredFormat @map("recommended_format")
  notes             String?               @db.VarChar(1000)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  bunshin           Bunshin               @relation(fields: [workspaceId, bunshinId], references: [workspaceId, id], onDelete: Restrict)
  weeklyPlan        WeeklyPlan            @relation(fields: [workspaceId, bunshinId, weeklyPlanId], references: [workspaceId, bunshinId, id], onDelete: Restrict)
  contentPillar     ContentPillar         @relation(fields: [workspaceId, bunshinId, contentPillarId], references: [workspaceId, bunshinId, id], onDelete: Restrict)
  dailyMissions     DailyMission[]

  @@unique([weeklyPlanId, scheduledDate])
  @@unique([workspaceId, bunshinId, id])
  @@index([workspaceId, bunshinId, scheduledDate])
  @@index([contentPillarId])
  @@map("weekly_plan_items")
}

model DailyMission {
  id               String                @id @default(uuid()) @db.Uuid
  workspaceId      String                @map("workspace_id") @db.Uuid
  bunshinId        String                @map("bunshin_id") @db.Uuid
  socialProfileId  String?               @map("social_profile_id") @db.Uuid
  weeklyPlanItemId String?               @map("weekly_plan_item_id") @db.Uuid
  missionDate      DateTime              @map("mission_date") @db.Date
  status           DailyMissionStatus    @default(GENERATED)
  format           SocialPreferredFormat
  estimatedMinutes Int                   @map("estimated_minutes")
  topic            String                @db.VarChar(200)
  angle            String                @db.VarChar(500)
  reason           String                @db.VarChar(1000)
  qualityScore     Int?                  @map("quality_score")
  viewedAt         DateTime?             @map("viewed_at") @db.Timestamptz(6)
  startedAt        DateTime?             @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?             @map("completed_at") @db.Timestamptz(6)
  skippedAt        DateTime?             @map("skipped_at") @db.Timestamptz(6)
  expiredAt        DateTime?             @map("expired_at") @db.Timestamptz(6)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  bunshin          Bunshin               @relation(fields: [workspaceId, bunshinId], references: [workspaceId, id], onDelete: Restrict)
  socialProfile    SocialProfile?        @relation(fields: [workspaceId, bunshinId, socialProfileId], references: [workspaceId, bunshinId, id], onDelete: Restrict)
  weeklyPlanItem   WeeklyPlanItem?       @relation(fields: [workspaceId, bunshinId, weeklyPlanItemId], references: [workspaceId, bunshinId, id], onDelete: Restrict)
  content          MissionContent?

  @@unique([workspaceId, bunshinId, missionDate])
  @@unique([workspaceId, bunshinId, id])
  @@unique([workspaceId, bunshinId, id, format])
  @@index([workspaceId, bunshinId, status, missionDate])
  @@index([socialProfileId])
  @@index([weeklyPlanItemId])
  @@map("daily_missions")
}

model MissionContent {
  id             String                @id @default(uuid()) @db.Uuid
  workspaceId    String                @map("workspace_id") @db.Uuid
  bunshinId      String                @map("bunshin_id") @db.Uuid
  dailyMissionId String                @unique @map("daily_mission_id") @db.Uuid
  format         SocialPreferredFormat
  contentJson    Json                  @map("content_json")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  bunshin        Bunshin               @relation(fields: [workspaceId, bunshinId], references: [workspaceId, id], onDelete: Restrict)
  dailyMission   DailyMission          @relation(fields: [workspaceId, bunshinId, dailyMissionId, format], references: [workspaceId, bunshinId, id, format], onDelete: Cascade)

  @@unique([workspaceId, bunshinId, dailyMissionId])
  @@unique([workspaceId, bunshinId, dailyMissionId, format])
  @@index([workspaceId, bunshinId, format])
  @@map("mission_contents")
}

model BunshinObjective {
  id            String          @id @default(uuid()) @db.Uuid
  bunshinId     String          @map("bunshin_id") @db.Uuid
  objectiveType String          @map("objective_type") @db.VarChar(80)
  primaryGoal   String          @map("primary_goal") @db.VarChar(500)
  kpiName       String?         @map("kpi_name") @db.VarChar(160)
  kpiTarget     String?         @map("kpi_target") @db.VarChar(160)
  kpiPeriod     String?         @map("kpi_period") @db.VarChar(160)
  priority      Int
  status        ObjectiveStatus @default(ACTIVE)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  bunshin       Bunshin         @relation(fields: [bunshinId], references: [id], onDelete: Cascade)

  @@unique([bunshinId, priority])
  @@index([bunshinId, status])
  @@map("bunshin_objectives")
}

model BunshinAudience {
  id               String   @id @default(uuid()) @db.Uuid
  bunshinId        String   @map("bunshin_id") @db.Uuid
  label            String   @db.VarChar(160)
  ageRange         String?  @map("age_range") @db.VarChar(100)
  occupation       String?  @db.VarChar(160)
  experienceLevel  String?  @map("experience_level") @db.VarChar(100)
  painPoints       Json     @map("pain_points")
  desires          Json
  excludedAudience Json     @map("excluded_audience")
  notes            String?  @db.VarChar(1000)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  bunshin          Bunshin  @relation(fields: [bunshinId], references: [id], onDelete: Cascade)

  @@index([bunshinId])
  @@map("bunshin_audiences")
}

model BunshinPersonality {
  id                   String     @id @default(uuid()) @db.Uuid
  bunshinId            String     @unique @map("bunshin_id") @db.Uuid
  tone                 String     @db.VarChar(100)
  formality            String     @db.VarChar(100)
  energyLevel          String     @map("energy_level") @db.VarChar(100)
  expertiseLevel       String     @map("expertise_level") @db.VarChar(100)
  sentenceStyle        String     @map("sentence_style") @db.VarChar(500)
  firstPerson          String     @map("first_person") @db.VarChar(50)
  forbiddenExpressions Json       @map("forbidden_expressions")
  preferredExpressions Json       @map("preferred_expressions")
  visualDirection      String?    @map("visual_direction") @db.VarChar(500)
  facePolicy           FacePolicy @map("face_policy")
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  bunshin              Bunshin    @relation(fields: [bunshinId], references: [id], onDelete: Cascade)

  @@map("bunshin_personalities")
}
