{
  "name": "@bunshin/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node scripts/generate-client.mjs && tsc -p tsconfig.build.json",
    "db:generate": "node scripts/generate-client.mjs",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:assert-ready": "node scripts/generate-client.mjs && node scripts/assert-schema-ready.mjs",
    "lint": "eslint src test",
    "test": "vitest run --passWithNoTests --exclude '**/*.integration.test.ts'",
    "test:integration": "node scripts/generate-client.mjs && vitest run test/database.integration.test.ts",
    "typecheck": "node scripts/generate-client.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@bunshin/application": "workspace:*",
    "@bunshin/auth": "workspace:*",
    "@bunshin/capability-social": "workspace:*",
    "@bunshin/capability-fortune": "workspace:*",
    "@bunshin/capability-resale": "workspace:*",
    "@bunshin/capability-training": "workspace:*",
    "@bunshin/platform-domain": "workspace:*",
    "@bunshin/shared": "workspace:*",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "vitest": "^4.1.0"
  }
}
