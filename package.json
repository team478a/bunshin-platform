{
  "name": "bunshin-platform",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.1",
      "fflate": "0.7.5",
      "js-yaml": "4.3.2",
      "vitest": "4.1.11"
    }
  },
  "scripts": {
    "test:learning-ui": "e2e run --config scripts/test/learning-ui/e2e.config.ts",
    "architecture:check": "node scripts/check-architecture-boundaries.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm architecture:check && turbo run lint && pnpm lint:learning-ui",
    "lint:learning-ui": "eslint scripts/test/learning-ui/*.ts scripts/test/learning-ui/*.tsx",
    "test": "pnpm test:architecture && turbo run test",
    "test:architecture": "node --test scripts/test/architecture-boundaries.test.mjs",
    "test:integration": "pnpm --filter @bunshin/database test:integration",
    "typecheck": "turbo run typecheck && pnpm typecheck:learning-ui",
    "typecheck:learning-ui": "tsc -p scripts/test/learning-ui/tsconfig.json --noEmit",
    "db:generate": "pnpm --filter @bunshin/database db:generate",
    "db:validate": "pnpm --filter @bunshin/database db:validate",
    "db:migrate:dev": "pnpm --filter @bunshin/database db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @bunshin/database db:migrate:deploy",
    "db:migrate:vercel": "node packages/database/scripts/deploy-migrations-for-vercel.mjs",
    "db:migration:probe": "node packages/database/scripts/probe-migration-connection.mjs",
    "db:assert-ready": "pnpm --filter @bunshin/database db:assert-ready"
  },
  "devDependencies": {
    "@e2e-dev/web": "0.13.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.10.0",
    "e2e": "0.18.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.9.0",
    "turbo": "2.10.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "8.2.1",
    "vitest": "^4.1.0"
  }
}
